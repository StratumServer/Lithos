+	// Lithos start: Queued packets own their arrays until the network thread returns them.
+	private static Packet_EntityPosition[] lithosRentPositionArray(List<Packet_EntityPosition> packets, int offset, int count)
+	{
+		Packet_EntityPosition[] array = System.Buffers.ArrayPool<Packet_EntityPosition>.Shared.Rent(count);
+		for (int i = 0; i < count; i++)
+		{
+			array[i] = packets[offset + i];
+		}
+		return array;
+	}
+
+	private Packet_BulkEntityPosition lithosRentBulkPositionPacket(Packet_EntityPosition[] positions, int count)
+	{
+		if (!lithosBulkPositionPacketPool.TryDequeue(out Packet_BulkEntityPosition packet))
+		{
+			packet = new Packet_BulkEntityPosition();
+		}
+		packet.SetEntityPositions(positions, count, count);
+		return packet;
+	}
+
+	internal void LithosReturnBulkPositionPacket(Packet_UdpPacket udpPacket)
+	{
+		Packet_BulkEntityPosition packet = udpPacket.BulkPositions;
+		Packet_EntityPosition[] positions = packet.EntityPositions;
+		int positionsCount = packet.EntityPositionsCount;
+		udpPacket.BulkPositions = null;
+		packet.EntityPositions = null;
+		packet.EntityPositionsCount = 0;
+		packet.EntityPositionsLength = 0;
+		packet.size = 0;
+		Array.Clear(positions, 0, positionsCount);
+		System.Buffers.ArrayPool<Packet_EntityPosition>.Shared.Return(positions);
+		lithosBulkPositionPacketPool.Enqueue(packet);
+	}
+	// Lithos end.
