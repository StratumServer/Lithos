<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Lithos.Benchmarks</RootNamespace>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
    <BenchmarkInputDir>$(MSBuildThisFileDirectory)../../src/VintagestoryServer/bin/Release/net10.0/</BenchmarkInputDir>
    <BenchmarkModInputDir>$(MSBuildThisFileDirectory)../../src/bin/Release/net10.0/</BenchmarkModInputDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(BenchmarkInputDir)VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(BenchmarkModInputDir)VSEssentials.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Content Include="$(BenchmarkInputDir)*.dll"
             Exclude="$(BenchmarkInputDir)VintagestoryAPI.dll"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(BenchmarkInputDir)runtimes/**/*"
             Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckBenchmarkInput" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BenchmarkInputDir)VintagestoryAPI.dll')"
           Text="Build Lithos.slnx in Release before running this benchmark." />
    <Error Condition="!Exists('$(BenchmarkModInputDir)VSEssentials.dll')"
           Text="Build Lithos.slnx in Release before running this benchmark." />
  </Target>
</Project>
